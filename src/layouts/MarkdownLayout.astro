---
import MarkdownContainer from "@components/markdown-container.astro";
import { Picture } from "astro:assets";
import "../styles/markdown.css";
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className } = Astro.props;
---

<Layout title={title}>
  <MarkdownContainer class={className}>
    <div class="flex flex-col max-w-screen-md mx-auto px-5 md:px-0">
      <div class="grid grid-cols-2 w-full justify-between items-end">
        <div class="flex flex-col">
          <h1 class="font-bold leading-none" style="font-size: 3em; margin-bottom: 0;">
            <mark>
              {title}
            </mark>
          </h1>
          <p>{description}</p>
        </div>
        <Picture
          src="/layout/header-mountains-narrow.png"
          alt="Header Image"
          width={386}
          height={110}
        />
      </div>
      <hr />
    </div>

    <slot />
  </MarkdownContainer>
</Layout>
