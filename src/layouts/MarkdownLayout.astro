---
import MarkdownContainer from "@components/markdown-container.astro";
import Layout from "./Layout.astro";
import "../styles/markdown.css";

export interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className } = Astro.props;
---

<Layout title={title}>
  <MarkdownContainer class={className}>
    <div class="flex flex-col max-w-screen-md mx-auto px-5 md:px-0">
      <h1 class="font-bold" style="font-size: 3em; margin-bottom: 0;">
        <mark>
          {title}
        </mark>
      </h1>
      <p>{description}</p>
      <hr />
    </div>

    <slot />
  </MarkdownContainer>
</Layout>
