---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";

export interface Props {
  title: string;
  variant?: "default" | "home" | "404";
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site,
).toString();

const { title, variant = "default" } = Astro.props;

const makeTitle = title ? title + " | " + "SES" : "McMaster SES";
---

<!doctype html>
<html lang="en" class="bg-background">
  <head>
    <base href="/" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <link
      href="https://fonts.googleapis.com/css?family=Londrina+Outline"
      rel="stylesheet"
      type="text/css"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#a6192e" />
    <meta name="msapplication-TileColor" content="#b91d47" />
    <meta name="theme-color" content="#0f0e17" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script
    is:inline
    src={`https://www.googletagmanager.com/gtag/js?id=${process.env.GA_ID}`}
    ></script>
    <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", process.env.GA_ID);
    </script>

    <!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
    <SEO
      title={makeTitle}
      description="Official website for McMaster Software Engineering Society."
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `McMaster Software Engineering Society`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "McMaster SES Homepage Screenshot",
        },
      }}
    />
  </head>
  <body class="dark">
    <div class="min-h-screen flex flex-col justify-between">
      <div
        class:list={[
          variant === "404" &&
            "bg-[url('/404-error-page/background-image.png')] bg-top min-h-screen bg-repeat-x",
        ]}
        style={{
          backgroundSize: "auto 1038px",
        }}>
        <Navbar />
        <slot />
      </div>
      <Footer isHome={variant === "home"} />
    </div>
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
