---
import Container from "@components/container.astro";
import { Astronav, MenuIcon, MenuItems } from "astro-navbar";
import Dropdown from "./dropdown.astro";

export type MenuItem = {
  title: string;
  path?: string;
  dropdownItems?: {
    title: string;
    path: string;
    badge?: boolean;
    children?: {
      title: string;
      path: string;
      badge?: boolean;
    }[];
  }[];
  badge?: boolean; // Displays a 'New' badge next to the menu item
};

const menuItems: MenuItem[] = [
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Events",
    path: "/events",
  },
  {
    title: "Blog",
    path: "/blog",
    badge: true,
  },
  {
    title: "Contact",
    dropdownItems: [
      { title: "Academic concerns", path: "/contact/academic-concerns" },
      { title: "Submit a suggestion", path: "/contact/suggestions" },
      { title: "Sponsor us ✨", path: "/contact/sponsorship" },
    ],
  },
  {
    title: "Resources",
    dropdownItems: [
      {
        title: "Past course outlines",
        path: "/courses/past-outlines",
        badge: true,
      },
      {
        title: "FAQs",
        path: "/faq",
        badge: true,
      },
      {
        title: "Experiences",
        path: "/experiences",
        badge: true,
        children: [
          {
            title: "Internships",
            path: "/experiences/internships",
          },
          {
            title: "Clubs & Teams",
            path: "/experiences/clubs-and-teams",
          },
          {
            title: "Hackathons",
            path: "/experiences/hackathons",
          },
          {
            title: "Conferences",
            path: "/experiences/conferences",
          },
        ],
      },
    ],
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center py-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg"
          ><span class="text-slate-500">McMaster</span><span
            class="font-bold text-slate-400">SES</span
          >
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-slate-400" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuItems.map((item, index) => (
              <>
                {item.dropdownItems && (
                  <Dropdown
                    title={item.title}
                    items={item.dropdownItems}
                    lastItem={index === menuItems.length - 1}
                  />
                )}

                {!item.dropdownItems && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-slate-400 hover:text-slate-500">
                      <span> {item.title}</span>
                      {item.badge && (
                        <span class="ml-1 px-2 py-0.5 text-[10px] font-semibold uppercase text-white bg-primary rounded-full">
                          New
                        </span>
                      )}
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
      </MenuItems>
    </Astronav>
  </header>
</Container>
