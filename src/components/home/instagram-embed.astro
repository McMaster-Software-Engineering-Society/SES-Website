---
const embedPosts = (await Astro.glob("../../content/instagramPosts/*.astro"))
  .sort((a, b) => {
    const aNum = a.default.moduleId
      ? parseInt(a.default.moduleId.slice(0, -6).split("-").pop() ?? "")
      : 0;
    const bNum = b.default.moduleId
      ? parseInt(b.default.moduleId.slice(0, -6).split("-").pop() ?? "")
      : 0;
    return aNum - bNum;
  })
  .reverse();

// Change the number of posts to display
const numDisplayPosts = 3;
---

<div
  id="instagram-posts"
  class="flex flex-col lg:flex-row gap-4 lg:max-w-none items-center lg:items-start lg:justify-around">
  {
    embedPosts.slice(0, numDisplayPosts).map((post) => (
      <div class="max-w-xs">
        <post.default />
      </div>
    ))
  }
</div>
