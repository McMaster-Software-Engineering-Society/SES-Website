---
import { Skeleton } from "@nextui-org/react";
---

<div class="grid grid-cols-3 gap-x-6 items-center">
  <Skeleton disableAnimation className="rounded-md w-full h-full" />
  <div class="col-span-2 flex flex-col gap-y-1">
    <div class="flex gap-2 text-xs">
      <Skeleton disableAnimation className="rounded-md">
        <span class="text-gray-400">
          <!-- {author} -->
          First LastName
        </span>
      </Skeleton>
      <Skeleton disableAnimation className="rounded-md">
        <time class="text-gray-400"> Mon Jan 01 0000 </time>
      </Skeleton>
    </div>
    <Skeleton disableAnimation className="rounded-md w-4/5">
      <h2 class="text-md font-semibold line-clamp-1">
        <!-- {title} -->
        Lorem ipsum dolor sit amet
      </h2>
    </Skeleton>
    <Skeleton disableAnimation className="rounded-md w-1/4">
      <span class="text-blue-400 uppercase tracking-wider text-xs font-medium">
        <!-- {category} -->
        Category
      </span>
    </Skeleton>
  </div>
</div>
