---
import { getCollection } from "astro:content";
import { FaLocationDot } from "@react-icons/all-files/fa6/FaLocationDot";
import { FaCircleInfo } from "@react-icons/all-files/fa6/FaCircleInfo";

const hackathonsAtMac = await getCollection("hackathonsAtMac");

const formatDate = (date: Date) => {
  // Get the day, month, and year from the date object
  const day = date.getDate();
  const month = date.getMonth() + 1; // Months are zero-based
  const year = date.getFullYear();

  // Add leading zero to day and month if needed
  const dayString = day < 10 ? "0" + day : day;
  const monthString = month < 10 ? "0" + month : month;

  // Construct the date string in DD.MM.YYYY format
  return `${dayString}.${monthString}.${year}`;
};
---

<div class="flex flex-col gap-y-4">
  {
    hackathonsAtMac.map((hackathon) => (
      <div
        id={hackathon.data.title}
        class="flex flex-row items-center px-8 py-4 bg-slate-950 rounded-xl gap-x-4">
        <div class="hackathon-picture rounded-lg m-2">Img here</div>
        <div class="flex flex-col gap-y-3">
          <div class="date-and-location flex flex-row text-sm">
            {hackathon.data.date && (
              <span class="border-r-2 border-slate-600 pr-2 mr-2">
                {formatDate(new Date(hackathon.data.date))}
              </span>
            )}
            <mark class="flex flex-row gap-x-2 items-center">
              <FaLocationDot />
              <span>{hackathon.data.location}</span>
            </mark>
          </div>
          <div class="flex flex-col gap-y-1">
            <span class="text-xl font-bold">{hackathon.data.title}</span>
            <span class="text-sm">{hackathon.data.description}</span>
          </div>
          <div class="flex flex-row justify-between">
            <div class="flex flex-row items-center gap-x-2">
              <FaCircleInfo />
              <a
                href={hackathon.data.link}
                class="text-blue-500 hover:underline">
                Details
              </a>
            </div>
            {hackathon.data.date && <span class="text-sm">Starts in 3 days</span>}
          </div>
        </div>
        {/* <h2>{hackathon.data.title}</h2> */}
        {/* <p>{hackathon.data.description}</p> */}
      </div>
    ))
  }
</div>
