---
import { Button } from "@nextui-org/react";
import { getCollection } from "astro:content";

const internshipLists = await getCollection("internshipLists");
---

<div class="flex flex-col gap-y-4">
  {
    internshipLists.map((item) => (
      <div class="flex flex-row items-center justify-between w-full">
        <div class="flex flex-col sm:flex-row gap-x-1">
          <span class="font-bold line-clamp-1">{item.data.title}</span>
          <div class="flex flex-row gap-x-1 text-slate-400">
            <span class="hidden sm:block">&#8212; </span>
            <span class="italic line-clamp-1 pr-1">{item.data.author}</span>
          </div>
        </div>
        <a href={item.data.link} target="_blank">
          <Button size="sm">View</Button>
        </a>
      </div>
    ))
  }
</div>
