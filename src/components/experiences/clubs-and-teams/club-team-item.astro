    <picture>
      <img
        src={"/experiences/clubs-and-teams/gdsc-logo.png"}
        alt={"GDSC logo"}
        class="rounded-lg"
      />
    </picture>
  </div>

  <div class="clubsteams-details col-span-4 flex flex-col gap-y-3 py-3 pr-2">
    <div class="type-and-location flex flex-row text-sm">
      <span class="border-r-2 border-slate-600 pr-2 mr-2">
        Technical Club
      </span>
      <mark class="flex flex-row gap-x-1 items-center">
        <FaLocationDot />
        <span>McMaster University</span>
      </mark>
    </div>
    <div class="flex flex-col gap-y-1">
      <span class="text-xl font-bold">Google Developer Student Club </span>
      <span class="text-sm line-clamp-2">
        Google DSC McMasterU is McMaster University's chapter of the Google
        Developer Student Clubs, supported by Google and Google Developers.
      </span>
    </div>
    <div class="flex flex-row justify-between">
      <div class="flex flex-row items-center gap-x-1">
        <div class="text-xs">
          <FaCircleInfo />
        </div>
        <a
          href="https://gdsc.community.dev/mcmaster-university-hamilton-canada/"
          class="text-sm">
          Details
        </a>
      </div>
    </div>
  </div>
</div>

<div
  class="clubsteams-desktop grid grid-cols-5 items-center px-3 rounded-xl gap-x-5 max-h-48 bg-slate-950">
  <div class="clubsteams-picture">
    <!-- TODO: Change <img> to <Picture> -->
    <picture>
      <img
        src={"/experiences/clubs-and-teams/robomaster-logo.png"}
        alt={"GDSC logo"}
        class="rounded-lg"
      />
    </picture>
  </div>

  <div class="clubsteams-details col-span-4 flex flex-col gap-y-3 py-3 pr-2">
    <div class="type-and-location flex flex-row text-sm">
      <span class="border-r-2 border-slate-600 pr-2 mr-2"> Team </span>
      <mark class="flex flex-row gap-x-1 items-center">
        <FaLocationDot />
        <span>McMaster University</span>
      </mark>
    </div>
    <div class="flex flex-col gap-y-1">
      <span class="text-xl font-bold"> RoboMaster </span>
      <span class="text-sm line-clamp-2">
        MAC RoboMaster is a team of highly motivated and passionate students
        from the McMaster University located in Ontario, Canada. We participate
        in the yearly RoboMaster Robotics Competition where we compete against
        universities all over the world. Each season, the team is tasked with
        developing a group of RC and autonomous battle robots from the ground
        up. This multidisciplinary project is no small task, but we love what we
        do and are committed to learning and developing as future professionals.
        We come from many faculties within engineering as well as business, and
        strive for excellence every day.
      </span>
    </div>
    <div class="flex flex-row justify-between">
      <div class="flex flex-row items-center gap-x-1">
        <div class="text-xs">
          <FaCircleInfo />
        </div>
        <a href="https://macrobomaster.com/" class="text-sm"> Details </a>
      </div>
    </div>
  </div>
</div>

