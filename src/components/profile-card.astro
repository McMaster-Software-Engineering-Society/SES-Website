---
const { name, title, image, description } = Astro.props;
---

<div class="profile-card">
  <div class="profile-card-upper">
    <img src={image} alt={`${name}'s picture`} class="profile-image" />
  </div>
  <div class="profile-card-lower">
    <div class="profile-info">
      <h2>{name}</h2>
      <h3>{title}</h3>
      <p>{description}</p>
    </div>
  </div>
</div>

<style>
   .profile-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 250px;
    margin: 10px;
    border: 1px solid #ccc;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  .profile-card-upper {
    background-color: rgb(180, 175, 175);
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 20px 0;
    margin-bottom: -10px;
    position: relative
  }

  .profile-card-lower {
    background-color: white;
    width: 100%;
    padding: 20px;
    border-radius: 20px 20px 0 0;
    margin-top: -5px;
    position: relative
  }

  .profile-image {
    border-radius: 50%;
    width: 100px;
    height: 100px;
  }

  .profile-info {
    text-align: center;
  }

  .profile-info h2 {
    margin: 10px 0 5px;
    font-size: 1.4em;
    color: #0a777a;
    font-weight: bold;
  }

  .profile-info h3 {
    margin: 5px 0;
    font-size: 1em;
    color: #0a777a;
  }

  .profile-info p {
    font-size: 0.9em;
    color: #0a777a;
  }

  .team-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
