---
export interface Props {
  question: string;
  answer: string;
  category?: string;
}

const { question, answer} = Astro.props;
---

<div class="mt-5 w-full bg-[#27272a] rounded-md list-disc">
  <details class="open:bg-zinc-300 open:rounded-md open:text-black">
    <summary class="font-bold p-5 hover:bg-primary">&nbsp &nbsp"{question}"</summary>
    <p class="pr-5 pl-5 pb-5">{answer}</p>

  </details>
</div>

<style>
  details[open] summary:hover {
  background-color: inherit; 
  }
</style>
