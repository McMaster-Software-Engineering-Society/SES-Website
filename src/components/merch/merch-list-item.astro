---
import MerchItemQuantityIndicator from "./merch-item-quantity-indicator.astro";

export type MerchItemType = {
  id: string;
  imageSrc: string;
  backImageSrc?: string;
  name: string;
  price: number;
  quantities: {
    small?: number;
    medium?: number;
    large?: number;
    xlarge?: number;
  };
};

export interface Props {
  item: MerchItemType;
}

const { item } = Astro.props;

const backImageSrc = item.backImageSrc;
const hasBackImage = !!backImageSrc;
const sanitizedId = item.id.replace(/[^a-zA-Z0-9_-]/g, "-") || "item";
const flipId = `merch-flip-${sanitizedId}`;

const sizeMap = {
  small: "SM",
  medium: "MD",
  large: "LG",
  xlarge: "XL",
};

const sizeMapFull = {
  small: "SMALL",
  medium: "MEDIUM",
  large: "LARGE",
  xlarge: "X-LARGE",
};
---

<div class="flex flex-col">
  <div
    class="merch-image-container relative w-full overflow-hidden rounded-2xl group md:cursor-pointer"
    style="aspect-ratio: 1 / 1;">
    {
      hasBackImage && (
        <input
          type="checkbox"
          id={flipId}
          class="merch-flip-toggle peer sr-only"
          aria-hidden="true"
        />
      )
    }
    <!-- Front Image -->
    <img
      src={item.imageSrc}
      alt={item.name}
      width="800"
      height="800"
      loading="lazy"
      decoding="async"
      class="merch-front-image absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-300 md:group-hover:opacity-0 peer-checked:opacity-0"
    />

    <!-- Back Image -->
    {
      hasBackImage && (
        <img
          src={backImageSrc}
          alt={`${item.name} (back)`}
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
          class="merch-back-image absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300 md:group-hover:opacity-100 peer-checked:opacity-100"
        />
      )
    }

    <!-- Flip Button (visible on mobile only) -->
    {
      hasBackImage && (
        <label
          for={flipId}
          class="flip-button absolute top-3 right-3 bg-black/60 hover:bg-black/80 text-white rounded-full p-2 backdrop-blur-sm z-10 cursor-pointer md:hidden"
          role="button"
          aria-label="Toggle alternate merch image">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10" />
            <polyline points="1 20 1 14 7 14" />
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
          </svg>
        </label>
      )
    }
  </div>
  <div class="flex flex-col mt-4">
    <p class="font-bold">{item.name}</p>
    <p class="md:hidden block">${item.price}</p>
  </div>
  <div
    class="flex flex-col md:flex-row items-start md:items-center justify-between gap-y-2 mt-1 md:mt-0 gap-x-3">
    <!-- Price -->
    <p class="hidden md:block">${item.price}</p>
    <!-- Size Availability -->
    <div
      class="grid grid-cols-2 w-full md:w-auto md:flex md:flex-row md:items-center gap-x-3">
      <MerchItemQuantityIndicator
        sizeLabel={sizeMap.small}
        sizeLabelFull={sizeMapFull.small}
        quantity={item.quantities.small ?? 0}
      />
      <MerchItemQuantityIndicator
        sizeLabel={sizeMap.medium}
        sizeLabelFull={sizeMapFull.medium}
        quantity={item.quantities.medium ?? 0}
      />
      <MerchItemQuantityIndicator
        sizeLabel={sizeMap.large}
        sizeLabelFull={sizeMapFull.large}
        quantity={item.quantities.large ?? 0}
      />
      <MerchItemQuantityIndicator
        sizeLabel={sizeMap.xlarge}
        sizeLabelFull={sizeMapFull.xlarge}
        quantity={item.quantities.xlarge ?? 0}
      />
    </div>
  </div>
</div>
