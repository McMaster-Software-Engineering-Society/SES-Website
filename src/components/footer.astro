---
export interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;

// import PageLayout from "@layouts/PageLayout.astro";
import { FaGithub } from "@react-icons/all-files/fa/FaGithub";
// import { FaApple } from "@react-icons/all-files/fa/FaApple";
// import { FaGooglePlay } from "@react-icons/all-files/fa/FaGooglePlay";
import { FaInstagram } from "@react-icons/all-files/fa/FaInstagram";
import { FaEnvelope } from "@react-icons/all-files/fa/FaEnvelope";
---

<footer
  class:list={[
    "py-20 px-10 flex flex-col gap-y-5 text-slate-500 items-center",
    isHome && "bg-[#0f0e17] z-[98] relative",
  ]}>
  <!-- --------- -->
  <h3>
    <span class="text-slate-500">McMaster</span><span
      class="font-bold text-slate-400">SES</span
    >
  </h3>

  <div class="flex flex-col items-center gap-y-3">
    <nav class="flex justify-center max-w-screen-md">
      <ul
        class="flex justify-center gap-x-4 gap-y-1 items-center flex-row flex-wrap">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/">Contact</a></li>
        <li><a href="/events">Events</a></li>
        <li><a href="/">Resources</a></li>
      </ul>
    </nav>

    <div class="flex flex-row justify-center px-5">
      <a href="#" class="text-lg p-2"><FaGithub /></a>
      <a href="#" class="text-lg p-2"><FaEnvelope /></a>
      <a href="#" class="text-lg p-2"><FaInstagram /></a>
    </div>

    <p class="text-center text-xs text-slate-500">
      Copyright © {new Date().getFullYear()} Software Engineering Society.
    </p>
  </div>
</footer>

