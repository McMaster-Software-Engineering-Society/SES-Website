---
import { socialMedia } from "data/social-media";

export interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;
---

<footer
  class:list={[
    "py-20 px-10 flex flex-col gap-y-3 text-slate-500 items-center",
    isHome && "bg-[#0f0e17] z-[98] relative",
  ]}>
  <!-- --------- -->
  <h3>
    <span class="text-slate-500">McMaster</span><span
      class="font-bold text-slate-400">SES</span
    >
  </h3>

  <div class="flex flex-row flex-wrap justify-center px-5 gap-x-1">
    {
      socialMedia.map((media) => (
        <a
          href={media.url}
          class="text-lg p-2"
          target="_blank"
          aria-label={`SES's ${media.platform}`}>
          <media.icon />
        </a>
      ))
    }
  </div>

  <p class="text-center text-xs text-slate-500">
    Copyright © {new Date().getFullYear()} Software Engineering Society.
  </p>

  <!-- <div class="flex flex-col items-center gap-y-3">
    <nav class="flex justify-center max-w-screen-md">
      <ul
        class="flex justify-center gap-x-4 gap-y-1 items-center flex-row flex-wrap">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/">Contact</a></li>
        <li><a href="/events">Events</a></li>
        <li><a href="/">Resources</a></li>
      </ul>
    </nav>
-->
</footer>
