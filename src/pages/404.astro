<PageLayout title="404 page">
  <!-- <img class="left-0 top-0 w-full h-full" src="/public/404-error-page/background-image.jpg"/> -->
  <div
    class="content bg-[url('/404-error-page/background-image.jpg')] h-screen flex flex-col justify-center items-center text-white bg-cover opacity-90">
    <h1 class="text-[150px] font-bold font-londrina">404</h1>
    <h2 class="text-[40px] font-bold -mt-12">Page Not Found</h2>
    <p class="text-center max-w-96 items-center mt-1">
      Oops! The page you are looking for doesn't exist. You might have entered
      an incorrect URL or the page might have been moved or deleted.
    </p>
    <a
      href="/"
      class="button rounded-full bg-[#080a17] p-[15px] px-[40px] border-2 mt-4"
      >Return Home</a
    >
  </div>
</PageLayout>
