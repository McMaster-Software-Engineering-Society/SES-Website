---
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 Page" variant="404">
  <div
    class="h-screen relative flex flex-col justify-center items-center text-white bg-cover opacity-90 mb-20">
    <h1 class="text-[100px] md:text-[150px] font-bold font-londrina">404</h1>
    <h2 class="text-3xl md:text-[40px] font-bold -mt-5">Page Not Found</h2>
    <p class="text-center max-w-screen-sm items-center mt-3 px-5">
      Oops! The page you are looking for doesn't exist. You might have entered
      an incorrect URL or the page might have been moved or deleted.
    </p>
    <a href="/" class="rounded-full bg-[#080a17] py-2 px-8 border-2 mt-5"
      >Return Home</a
    >
  </div>
</Layout>
