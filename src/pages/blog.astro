---
import BlogList from "@components/blog/blog-list";
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection("blogPosts", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Sort content entries by publication date
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<!-- TODO: Add search bar & category filter -->
<PageLayout title="Blog" class="flex flex-col items-center">
  <h1 class="text-[2.75rem] font-bold pt-10">
    Our <span class="text-primary">Blog</span>
  </h1>
  <span class="mt-3 text-center">
    Written by Software Engineering students, for Software Engineering students.
  </span>
  <main class="mt-8 w-full">
    <BlogList publishedBlogEntries={publishedBlogEntries} client:visible />
  </main>
</PageLayout>
