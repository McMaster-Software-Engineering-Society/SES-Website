---
import FaqItem from "@components/faq/faq-item.astro";
import PageLayout from "@layouts/PageLayout.astro";

import { getCollection } from "astro:content";

const questions = await getCollection("faqs");

const grades = {
  willie: {
    math: 90,
    science: 80,
    english: 70,
  },
  senuni: {
    math: 99,
    science: 98,
    english: 97,
  },
};

console.log(grades["willie"]?.math);
console.log(grades["michael"]?.english);
---

<PageLayout title="FAQ" class="flex flex-col items-left justify-right">
  <div class="intro">
    <h1 class="text-[44px] font-bold text-white pt-10">
      Frequently Asked Questions <span class="text-primary">(FAQ)</span>
    </h1>
    <p class="mt-3 text-left font-thin max-w-screen-sm">
      Find answers to common questions we get about our society and all things
      software engineering. If you have more questions, feel free to contact us!
    </p>
    <div class="h-px mt-8 bg-gray-700 w-full"></div>
  </div>

  {
    questions.map((question) => (
      <FaqItem
        question={question.data.question}
        answer={question.data.answer}
        category={question.data.category}
      />
    ))
  }

  <div class="h-px mt-8 bg-gray-700 w-full"></div>
</PageLayout>
