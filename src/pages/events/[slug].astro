---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
// import { Button } from "@nextui-org/react";
import { FaMapMarkerAlt } from "@react-icons/all-files/fa/FaMapMarkerAlt";
import { FaCopy } from "@react-icons/all-files/fa/FaCopy";
import { FaCalendarAlt } from "@react-icons/all-files/fa/FaCalendarAlt";
import { FaMapMarkedAlt } from "@react-icons/all-files/fa/FaMapMarkedAlt";



export async function getStaticPaths() {
  const eventEntries = await getCollection("events");
  return eventEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { event: entry },
  }));
}

const { event } = Astro.props;
const { Content } = await event.render();
---

<PageLayout title={event.data.title} class="flex justify-center">

  <!-- <a href="/events"><Button>Back to events</Button></a>
  <h3>{event.data.title}</h3>
  <p>{event.data.location}</p>
  <p>{event.data.startDateTime}</p>
  <p>{event.data.endDateTime}</p>
  <p>{event.data.googleMapsLink}</p>
  <p>{event.data.image?.src}</p> 
  <Content /> -->
  <script>
    
  </script>
  
  <section class="max-w-screen-lg w-full flex flex-col my-10">

    <section class="flex flex-col-reverse lg:flex-row justify-between">

      <div class="flex flex-col items-start text-slate-400">
        <h1 class="font-bold text-4xl text-slate-300">{event.data.title}</h1>
        <div class="flex flex-col mt-8">
          <div class="flex flex-row items-center"> 
            <p class="mr-2"><FaCalendarAlt /></p>
            <p class="text-lg">Start: {event.data.startDateTime}</p>
          </div>
          <!-- <div class="flex flex-row items-center"> 
            <p class="mr-2"><FaCalendarAlt /></p>
            <p class="text-lg">End: {event.data.endDateTime}</p>
          </div> -->
          <div class="flex flex-row items-center"> 
            <p class="mr-2"><FaMapMarkedAlt /></p>
            <p class="mt-1 text-lg">{event.data.location}</p>
          </div>
        </div>
        <div class="flex text-slate-300 text-md mt-4 gap-3">
          <a href={event.data.googleMapsLink} target="_blank" class={`flex items-center rounded-lg px-3 py-2 ${event.data.googleMapsLink ? 'bg-gray-800' : 'hidden'}`}>
            <p class="mr-1"><FaMapMarkerAlt /></p>
            <p class={` ${event.data.googleMapsLink ? 'text-slate-300' : 'text-slate-500'}`}>Google Maps</p>
          </a>
          <button id="share-button" class="flex items-center rounded-lg bg-gray-800 px-3 py-2">
            <p class="mr-1"><FaCopy /></p>
            <p id="share-display">Share</p>
          </button>
        </div>
      </div>

      <div class="shadow-gray-800 lg:block lg:w-1/3 sm:hidden h-full rounded-lg lg:ml-4">
        <!-- <img src={event.data.image?.src} alt={event.data.image?.alt} class="" /> -->
         <!-- Temporary image for checking -->
        <img src="https://cdn.mos.cms.futurecdn.net/7qYc6jWRZSx5cwCNEw85xj-1200-80.jpg" class="rounded-xl lg:pb-0 pb-10"/>

        <p class="rounded-xl lg:pb-0 pb-10">{event.data.image?.src}</p> 
      </div>

    </section>

    <section class="flex flex-col items-start mt-6 text-slate-400">
      <div class="text-lg font-semibold"><Content /></div>
      
      <a href="/events" class="text-md font-semibold rounded-lg text-slate-300 bg-gray-800 px-3 py-2 my-8">Back</a>
      
      <!-- <a href="/events" class="my-5"><Button>Back</Button> -->
    </section>

  </section>

  
  <script>
    document.getElementById('share-button').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        // alert('URL copied to clipboard!');
        document.getElementById('share-display').textContent= "Copied to Clipboard!"
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    });
  </script>
  
</PageLayout>

