---
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="Download SES App" class="gap-y-4 flex flex-col">
  <h1 class="text-2xl">Download SES App!</h1>
  <div id="step-1">
    <h2 class="text-lg">Step 1</h2>
    <h2>Click the Share button</h2>
    <img class="mt-4" src="/download/ses-app-instructions-1.png" />
  </div>
  <div id="step-2">
    <h2 class="text-lg">Step 2</h2>
    <h2>Click the Add to Home Screen button</h2>
    <img class="mt-4" src="/download/ses-app-instructions-2.png" />
  </div>
  <div id="step-3">
    <h2 class="text-lg">Step 3</h2>
    <h2>Click the Add button</h2>
    <img class="mt-4" src="/download/ses-app-instructions-3.png" />
  </div>
</PageLayout>
